generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum SessionType {
  KEYNOTE
  TALK
  PANEL
  WORKSHOP
  DEMO
  NETWORKING
  BREAK
  OTHER
}

enum TicketKind {
  FREE
  PAID
}

enum RegistrationStatus {
  COMING_SOON
  OPEN
  CLOSED
}

enum CommunityType {
  STUDENT_TRIBE
  CAMPUS
  CREATIVE
  INDUSTRY
}

// Named creative/industry verticals — the taxonomy behind the community
// directory's group filter. Student tribes and campus communities leave
// `category` null.
enum CommunityCategory {
  FILM
  MUSIC
  FASHION
  ADVERTISING
  REAL_ESTATE
  LEGAL
  FINANCE
  ARCHITECTURE
  CONSTRUCTION
  HEALTHCARE
  TELECOM
  EDUCATION
  SUSTAINABILITY
  MOBILITY
  CONSUMER_PRODUCTS
}

enum EventSource {
  GROOVVEE
  EXTERNAL
}

enum DiscoveryRunStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum DiscoveryReviewStatus {
  PENDING
  APPROVED
  REJECTED
  DUPLICATE
}

enum LocationType {
  CITY
  COUNTRY_FALLBACK
}

enum CompetitionKind {
  HACK_WARS
  CONTEST
  COMMUNITY_CONTEST
}

enum CompetitionStatus {
  UPCOMING
  REGISTRATION_OPEN
  RUNNING
  COMPLETED
}

enum InquiryType {
  GENERAL
  PARTNERSHIP
  SPONSORSHIP
  STUDIO_PARTICIPATION
  EVENTS
  PRESS
  COMMUNITY
  SPEAKER_APPLICATION
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

enum MessageStatus {
  NEW
  READ
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

model Admin {
  id                   String               @id @default(cuid())
  name                 String
  email                String               @unique
  passwordHash         String
  role                 AdminRole            @default(ADMIN)
  isActive             Boolean              @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  sessions             Session[]
  reviewedApplications SpeakerApplication[]     @relation("ApplicationReviewer")
  reviewedMessages     ContactMessage[]         @relation("MessageReviewer")
  reviewedCompetitions CompetitionApplication[] @relation("CompetitionApplicationReviewer")
  judgingScores        JudgingScore[]
  discoveryRuns        DiscoveryRun[]
  reviewedDiscoveries  DiscoveredEvent[]

  @@map("admins")
}

model Session {
  id             String   @id @default(cuid())
  adminId        String
  admin          Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash      String   @unique
  expiresAt      DateTime
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([adminId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginThrottle {
  id          String    @id @default(cuid())
  key         String    @unique
  attempts    Int       @default(0)
  windowStart DateTime
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([lockedUntil])
  @@map("login_throttles")
}

model Speaker {
  id           String               @id @default(cuid())
  name         String
  title        String
  organization String
  bio          String               @db.Text
  imageUrl     String?
  socials      Json?
  featured     Boolean              @default(false)
  published    Boolean              @default(false)
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  agendaItems  AgendaItem[]
  applications SpeakerApplication[]

  @@index([published, featured, sortOrder])
  @@map("speakers")
}

model Topic {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  imageUrl    String?
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
  @@map("topics")
}

model AgendaItem {
  id          String      @id @default(cuid())
  title       String
  description String      @db.Text
  type        SessionType @default(TALK)
  startsAt    DateTime
  endsAt      DateTime
  location    String?
  published   Boolean     @default(false)
  sortOrder   Int         @default(0)
  speakers    Speaker[]
  eventId     String?
  event       Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([eventId])
  @@index([startsAt])
  @@index([published, sortOrder])
  @@map("agenda_items")
}

model TicketType {
  id            String     @id @default(cuid())
  name          String
  description   String     @db.Text
  kind          TicketKind
  priceMinor    Int        @default(0)
  currency      String     @default("USD") @db.VarChar(3)
  totalQuantity Int?
  maxPerOrder   Int        @default(10)
  salesStartAt  DateTime?
  salesEndAt    DateTime?
  isActive      Boolean    @default(true)
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([isActive, sortOrder])
  @@map("ticket_types")
}

model EventSettings {
  id                 String             @id @default(cuid())
  eventName          String
  tagline            String?
  eventDate          DateTime?
  venue              String?
  address            String?
  description        String?            @db.Text
  registrationStatus RegistrationStatus @default(COMING_SOON)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("event_settings")
}

model Community {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  type        CommunityType
  category    CommunityCategory?
  description String            @db.Text
  imageUrl    String?
  city        String?
  country     String?
  joinUrl     String?
  featured    Boolean           @default(false)
  published   Boolean           @default(false)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  events      Event[]

  @@index([type, published, sortOrder])
  @@index([category, published])
  @@map("communities")
}

// Canonical geography for events and discovery. `stateProvince` is "" (not
// null) when a place has none so the @@unique triple below actually dedupes
// — Postgres treats NULLs as distinct inside unique constraints.
model Location {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  type          LocationType @default(CITY)
  stateProvince String       @default("")
  country       String
  countryCode   String       @db.VarChar(2)
  region        String
  latitude      Float
  longitude     Float
  timezone      String?
  events        Event[]
  discoveries   DiscoveredEvent[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([name, stateProvince, countryCode])
  @@index([region, countryCode])
  @@map("locations")
}

model Event {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  description   String        @db.Text
  startsAt      DateTime
  endsAt        DateTime?
  timezone      String        @default("UTC")
  city          String?
  stateProvince String?
  country       String?
  region        String?
  venueName     String?
  isOnline      Boolean       @default(false)
  url           String?
  imageUrl      String?
  source        EventSource   @default(GROOVVEE)
  externalId    String?
  locationId    String?
  location      Location?     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  communityId   String?
  community     Community?    @relation(fields: [communityId], references: [id], onDelete: SetNull)
  featured      Boolean       @default(false)
  published     Boolean       @default(false)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  competitions  Competition[]
  agendaItems   AgendaItem[]
  duplicateDiscoveries DiscoveredEvent[] @relation("DiscoveryDuplicates")
  approvedDiscoveries  DiscoveredEvent[] @relation("ApprovedDiscoveries")

  @@index([published, startsAt])
  @@index([communityId])
  @@index([locationId])
  @@index([region, published])
  @@map("events")
}

// A single admin-triggered AI discovery run: what was searched, which
// provider/model produced the candidates, and how it ended.
model DiscoveryRun {
  id              String             @id @default(cuid())
  adminId         String
  admin           Admin              @relation(fields: [adminId], references: [id], onDelete: Restrict)
  provider        String
  model           String
  params          Json
  status          DiscoveryRunStatus @default(RUNNING)
  eventsFound     Int                @default(0)
  eventsInserted  Int                @default(0)
  duplicatesFound Int                @default(0)
  invalidCount    Int                @default(0)
  error           String?
  startedAt       DateTime           @default(now())
  completedAt     DateTime?
  candidates      DiscoveredEvent[]

  @@index([status, startedAt])
  @@index([adminId])
  @@map("discovery_runs")
}

// An unreviewed event candidate proposed by a discovery provider.
// Never public: candidates only become visible through an approved Event row.
model DiscoveredEvent {
  id                   String                @id @default(cuid())
  runId                String
  run                  DiscoveryRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  title                String
  normalizedTitle      String
  description          String                @db.Text @default("")
  startsAt             DateTime?
  endsAt               DateTime?
  timezone             String?
  venueName            String?
  city                 String?
  stateProvince        String?
  country              String?
  locationId           String?
  location             Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  registrationUrl      String?
  // Where the information was found — preserved verbatim, never overwritten
  // by a registration/ticketing link.
  sourceUrl            String
  sourceUrlNormalized  String
  imageUrl             String?
  provider             String
  model                String
  connector            String
  externalId           String?
  category             String?
  confidence           String?
  missingFields        String[]              @default([])
  evidence             String?               @db.Text
  // Possible duplicate of a published Event or another candidate — a flag
  // for reviewers, never an automatic merge.
  duplicateOfEventId   String?
  duplicateOfEvent     Event?                @relation("DiscoveryDuplicates", fields: [duplicateOfEventId], references: [id], onDelete: SetNull)
  duplicateOfCandidateId String?
  duplicateOfCandidate DiscoveredEvent?      @relation("CandidateDuplicates", fields: [duplicateOfCandidateId], references: [id], onDelete: SetNull)
  duplicateKind        String?
  status               DiscoveryReviewStatus @default(PENDING)
  reviewerAdminId      String?
  reviewer             Admin?                @relation(fields: [reviewerAdminId], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?
  reviewNotes          String?
  approvedEventId      String?
  approvedEvent        Event?                @relation("ApprovedDiscoveries", fields: [approvedEventId], references: [id], onDelete: SetNull)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  duplicateCandidates  DiscoveredEvent[]     @relation("CandidateDuplicates")

  @@unique([connector, externalId])
  @@index([status, createdAt])
  @@index([runId])
  @@index([locationId])
  @@index([sourceUrlNormalized])
  @@index([normalizedTitle])
  @@map("discovered_events")
}

model Competition {
  id           String                   @id @default(cuid())
  title        String
  slug         String                   @unique
  kind         CompetitionKind
  description  String                   @db.Text
  status       CompetitionStatus        @default(UPCOMING)
  startsAt     DateTime?
  endsAt       DateTime?
  prizeText    String?
  rulesUrl     String?
  imageUrl     String?
  eventId      String?
  event        Event?                   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  featured     Boolean                  @default(false)
  published    Boolean                  @default(false)
  sortOrder    Int                      @default(0)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  rounds       CompetitionRound[]
  teams        CompetitionTeam[]
  applications CompetitionApplication[]
  submissions  ChallengeSubmission[]

  @@index([kind, published])
  @@map("competitions")
}

model CompetitionRound {
  id            String                @id @default(cuid())
  competitionId String
  competition   Competition           @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name          String
  description   String?               @db.Text
  startsAt      DateTime?
  endsAt        DateTime?
  sortOrder     Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  submissions   ChallengeSubmission[]

  @@index([competitionId, sortOrder])
  @@map("competition_rounds")
}

model CompetitionTeam {
  id            String                   @id @default(cuid())
  competitionId String
  competition   Competition              @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  name          String
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  participants  CompetitionParticipant[]
  applications  CompetitionApplication[]
  submissions   ChallengeSubmission[]

  @@index([competitionId])
  @@map("competition_teams")
}

model CompetitionParticipant {
  id        String          @id @default(cuid())
  teamId    String
  team      CompetitionTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  school    String?
  role      String?
  createdAt DateTime        @default(now())

  @@index([teamId])
  @@map("competition_participants")
}

model CompetitionApplication {
  id                 String            @id @default(cuid())
  competitionId      String
  competition        Competition       @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  teamId             String?
  team               CompetitionTeam?  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  contactName        String
  email              String
  phone              String
  school             String
  major              String?
  gradYear           Int?
  intro              String            @db.Text
  previousExperience String?           @db.Text
  notes              String?           @db.Text
  status             ApplicationStatus @default(PENDING)
  reviewerId         String?
  reviewer           Admin?            @relation("CompetitionApplicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  reviewNotes        String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([competitionId, email])
  @@index([competitionId, status])
  @@index([teamId])
  @@map("competition_applications")
}

model ChallengeSubmission {
  id            String            @id @default(cuid())
  competitionId String
  competition   Competition       @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  roundId       String?
  round         CompetitionRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  teamId        String?
  team          CompetitionTeam?  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  title         String
  description   String?           @db.Text
  url           String?
  submittedAt   DateTime          @default(now())
  scores        JudgingScore[]

  @@index([competitionId])
  @@index([teamId])
  @@map("challenge_submissions")
}

model JudgingScore {
  id           String              @id @default(cuid())
  submissionId String
  submission   ChallengeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judgeId      String?
  judge        Admin?              @relation(fields: [judgeId], references: [id], onDelete: SetNull)
  score        Int
  notes        String?
  createdAt    DateTime            @default(now())

  @@unique([submissionId, judgeId])
  @@index([submissionId])
  @@map("judging_scores")
}

model NewsPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String    @db.VarChar(500)
  body          String    @db.Text
  coverImageUrl String?
  sourceUrl     String?
  authorName    String?
  publishedAt   DateTime?
  published     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published, publishedAt])
  @@map("news_posts")
}

model ContactMessage {
  id          String        @id @default(cuid())
  name        String
  email       String
  type        InquiryType   @default(GENERAL)
  subject     String?
  message     String        @db.Text
  status      MessageStatus @default(NEW)
  readAt      DateTime?
  reviewNotes String?       @db.Text
  reviewedAt  DateTime?
  reviewerId  String?
  reviewer    Admin?        @relation("MessageReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([readAt])
  @@map("contact_messages")
}

model SpeakerApplication {
  id           String            @id @default(cuid())
  name         String
  email        String
  organization String?
  talkTitle    String?
  bio          String            @db.Text
  links        Json?
  status       ApplicationStatus @default(PENDING)
  speakerId    String?
  speaker      Speaker?          @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  reviewerId   String?
  reviewer     Admin?            @relation("ApplicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNotes  String?           @db.Text
  createdAt    DateTime          @default(now())

  @@index([status, createdAt])
  @@index([reviewerId])
  @@map("speaker_applications")
}
