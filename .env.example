# Neon pooled connection URL — used by the app for normal queries
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Neon direct (unpooled) connection URL — used by Prisma for migrations
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Separate database for `npm run test:*` scripts (they create and delete rows).
# Must NOT be the same database as DATABASE_URL — tests refuse to run if it is.
# A Neon branch works well. Prepare it with: npm run test:db:migrate
TEST_DATABASE_URL=""
# Optional unpooled URL for the test DB, used for migrations.
TEST_DIRECT_URL=""

# HMAC secret for public form tokens (contact form, speaker application).
# Required in production — generate a long random value and keep it
# consistent across all app instances. Optional in local development.
FORM_SIGNING_SECRET=""

# Google Gemini API key — powers admin-triggered AI event discovery
# (/admin/discoveries). Server-side only, never exposed to the browser.
# Optional: when unset, discovery shows a configuration error and all
# other features work normally. Get a key at https://aistudio.google.com/
GEMINI_API_KEY=""

# Optional: override the Gemini model used for event discovery.
# Defaults to gemini-3.8-flash — set this when Google deprecates a model.
GEMINI_DISCOVERY_MODEL=""


# ==================== GMAIL OAUTH2 ====================
# Refresh token must carry the gmail.send scope and belong to GMAIL_SENDER
# (or an account allowed to send as it). Gmail API must be enabled.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER=""

# Comma-separated inboxes that receive admin alerts (new contact message,
# speaker application, Hack Wars application). Falls back to GMAIL_SENDER.
ADMIN_ALERT_EMAILS=""

# Absolute site URL used for links inside emails (e.g. registration
# confirmation). Required in production; defaults to localhost in dev.
SITE_URL="https://groovveeaifest.vercel.app"

# Admin TOTP 2FA. TOTP_ENCRYPTION_KEY encrypts stored secrets — generate a
# long random value before enabling enrollment. ADMIN_2FA_REQUIRED controls
# who must enroll: "all", "super_admin" (default), or "none".
TOTP_ENCRYPTION_KEY=""
ADMIN_2FA_REQUIRED=""