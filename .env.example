# Neon pooled connection URL — used by the app for normal queries
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Neon direct (unpooled) connection URL — used by Prisma for migrations
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# HMAC secret for public form tokens (contact form, speaker application).
# Required in production — generate a long random value and keep it
# consistent across all app instances. Optional in local development.
FORM_SIGNING_SECRET=""

# Google Gemini API key — powers admin-triggered AI event discovery
# (/admin/discoveries). Server-side only, never exposed to the browser.
# Optional: when unset, discovery shows a configuration error and all
# other features work normally. Get a key at https://aistudio.google.com/
GEMINI_API_KEY=""

# Optional: override the Gemini model used for event discovery.
# Defaults to gemini-3.8-flash — set this when Google deprecates a model.
GEMINI_DISCOVERY_MODEL=""
